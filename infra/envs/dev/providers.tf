terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  # PLAN-ONLY settings: allow `terraform plan` without an AWS account.
  # Remove these 5 lines (and set real AWS credentials) to deploy for real.
  access_key                  = "mock"
  secret_key                  = "mock"
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true

  default_tags {
    tags = {
      Project     = "hotel-booking"
      Environment = var.environment
    }
  }
}
